# =====================================================
# Joy4_sub - .gitignore
# =====================================================

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/

# --- Virtual environments (HUGE - 5GB) ---
.venv*/
venv/
env/
ENV/

# --- Build artifacts ---
build/
dist/
*.spec
pynsist_pkgs/
wheels/
*.whl
Joy4_sub setup/
lib/

# --- Bundled binaries (too large; install separately) ---
ffmpeg.exe
*.msi

# --- Local-only Claude Code settings ---
.claude/settings.local.json
.claude/cache/
.claude/sessions/

# --- IDE / Editor ---
.vs/
.idea/
.vscode/
*.swp
*.swo
*~

# --- OS-specific ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs / runtime files ---
*.log
runtime.log
.tmp_*

# --- Secrets / credentials ---
.env
.env.*
*.key
.joy4sub_claude_token
.vatsg_claude_token
secrets.json
credentials.json

# --- Misc ---
*.bak
*.tmp
*.orig
